{% import 'components/form/fields_macros.html.twig' as fields %}

<form action="{{ form_action }}" method="post">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ _n('Event manager', 'Events manager', 2, 'eventsmanager') }}</h3>
        </div>
        <div class="card-body">
            <div class="row">
                {{ fields.sliderField(
                    'use_with_plugin',
                    item.fields['use_with_plugin'],
                    __("Do you want to use this RSS feed to create event", 'eventsmanager') ~ ' ?'
                ) }}

                {% set entity_field %}
                    {% do call('Entity::dropdown', [{
                        'name': 'entities_id_import',
                        'value': item.fields['entities_id_import']
                    }]) %}
                {% endset %}
                {{ fields.field('entities_id_import', entity_field, __('Entity')) }}

                {% set impact_field %}
                    {% do call('Ticket::dropdownImpact', [{
                        'name': 'default_impact',
                        'value': item.fields['default_impact'],
                        'withmajor': 1
                    }]) %}
                {% endset %}
                {{ fields.field('default_impact', impact_field, __('Default impact', 'eventsmanager')) }}

                {% set priority_field %}
                    {% do call('CommonITILObject::dropdownPriority', [{
                        'name': 'default_priority',
                        'value': item.fields['default_priority'],
                        'withmajor': 1
                    }]) %}
                {% endset %}
                {{ fields.field('default_priority', priority_field, __('Default priority', 'eventsmanager')) }}

                {% set type_field %}
                    {% do call('GlpiPlugin\\Eventsmanager\\Event::dropdownType', [{
                        'name': 'default_eventtype',
                        'value': item.fields['default_eventtype']
                    }]) %}
                {% endset %}
                {{ fields.field('default_eventtype', type_field, __('Default event type', 'eventsmanager')) }}
            </div>
        </div>
        <div class="card-footer d-flex justify-content-center">
            <input type="hidden" name="id" value="{{ item.getID() }}">
            <input type="hidden" name="rssfeeds_id" value="{{ rssfeeds_id }}">
            {{ call('Html::submit', [_x('button', 'Save'), {'name': 'update', 'class': 'btn btn-primary'}])|raw }}
        </div>
    </div>

    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
