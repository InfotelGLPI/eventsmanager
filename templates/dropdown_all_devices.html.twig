{% if not hardware_enabled %}
    {{ myname_hidden|raw }}
    {{ items_id_hidden|raw }}
{% else %}
    <div id="tracking_all_devices{{ rand }}">
        {% if show_all %}
            {% if show_complete_search %}{{ __('Or complete search') }}&nbsp;{% endif %}
            {{ itemtypes_dropdown|raw }}
            {{ on_select_js|raw }}
            <span id="results_{{ myname }}{{ rand }}">
                {{ results|raw }}
            </span>
        {% endif %}
    </div>
{% endif %}
