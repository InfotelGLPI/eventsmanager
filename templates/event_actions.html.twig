{% set size_class = large ? ' fa-2x' : '' %}
{% set actions = actions|default(['assign', 'ticket', 'close']) %}

{% if 'assign' in actions %}
    <i class="ti ti-user-plus{{ size_class }} event-action" data-action="assign"
       data-event-id="{{ event_id }}"
       title="{{ __('Assign me to this event', 'eventsmanager') }}"
       style="float:left; cursor:pointer;"></i>
{% endif %}
{% if 'ticket' in actions %}
    <i class="ti ti-bell{{ size_class }} event-action" data-action="ticket"
       data-event-id="{{ event_id }}"
       title="{{ __('Create a ticket from the event', 'eventsmanager') }}"
       style="float:left; cursor:pointer;"></i>
{% endif %}
{% if 'close' in actions %}
    <i class="ti ti-archive{{ size_class }} event-action" data-action="close"
       data-event-id="{{ event_id }}"
       title="{{ __('Close the event', 'eventsmanager') }}"
       style="float:left; cursor:pointer;"></i>
{% endif %}
