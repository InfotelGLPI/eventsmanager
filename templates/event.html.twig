{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{% block form_fields %}
    {{ fields.autoNameField('name', item, __('Name'), withtemplate, field_options) }}
    {{ fields.htmlField('_item_add_form', item_add_form, __('Associated element', 'eventsmanager'), field_options) }}

    {{ fields.htmlField('impact', impact_field, __('Impact'), field_options) }}
    {{ fields.htmlField('plugin_eventsmanager_origins_id', origin_field, __('Origin', 'eventsmanager'), field_options) }}

    {{ fields.htmlField('priority', priority_field, __('Priority'), field_options) }}
    {{ fields.dropdownArrayField('eventtype', item.fields['eventtype'], eventtype_values, __('Event type', 'eventsmanager'), field_options) }}

    {{ fields.dropdownField('User', 'users_assigned', item.fields['users_assigned'], __('User assigned', 'eventsmanager'), field_options|merge({
        'entity': item.fields['entities_id'],
        'right': 'all',
    })) }}
    {{ fields.datetimeField('time_to_resolve', item.fields['time_to_resolve'], __('Time to resolve'), field_options) }}

    {% if show_status %}
        {{ fields.htmlField('status', status_field, __('Status'), field_options) }}
    {% endif %}
    {% if show_actions %}
        {{ fields.htmlField('_actions', actions, __('Actions', 'eventsmanager'), field_options) }}
    {% endif %}

    {{ fields.textareaField('comment', item.fields['comment'], __('Description'), field_options|merge({
        'enable_richtext': true,
        'enable_images': false,
        'enable_fileupload': false,
        'rows': 15,
        'full_width': true,
    })) }}

    {% if show_date_assign %}
        {{ fields.htmlField('date_assign', date_assign, __('Date Assign', 'eventsmanager'), field_options) }}
    {% endif %}
    {% if show_user_close %}
        {{ fields.htmlField('users_close', user_close_field, __('User close', 'eventsmanager'), field_options) }}
        {{ fields.htmlField('date_close', date_close, __('Close date'), field_options) }}
    {% endif %}
{% endblock %}
