{%- if kind == 'name' -%}
    <a id="{{ anchor_id }}" target="_blank" href="{{ url }}">{{ name }}</a>{{ tooltip|raw }}
{%- elseif kind == 'priority' -%}
    <div class="center" style="background-color:{{ bgcolor }};">{{ priority_name }}</div>
{%- elseif kind == 'date' -%}
    {%- if is_deleted -%}
        <div class="deleted">{{ date_display }}</div>
    {%- else -%}
        {{ date_display }}
    {%- endif -%}
{%- elseif kind == 'eventtype' -%}
    <div class="center" style="{{ type_color|raw }}">{{ type_name }}</div>
{%- elseif kind == 'actions' -%}
    <div style="min-width:100px;">{{ actions|raw }}</div>
{%- endif -%}
