<div class="firstbloc">
    <form name="eventitem_form" method="post" action="{{ add_form_action }}">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_2"><th colspan="2">{{ __('Add an item') }}</th></tr>
            <tr class="tab_bg_1">
                <td>
                    {{ devices_dropdown|raw }}
                    <span id="item_event_selection_information"></span>
                </td>
                <td class="center" width="30%">
                    <input type="hidden" name="plugin_eventsmanager_events_id" value="{{ instID }}">
                    <button type="submit" name="add" class="btn btn-primary">{{ _x('button', 'Add') }}</button>
                </td>
            </tr>
        </table>
    </form>
</div>
