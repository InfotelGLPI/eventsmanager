<div class="center">
    <form method="post" name="event_form" action="{{ create_form_action }}">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <th colspan="4">{{ __('Link to tickets', 'eventsmanager') }}</th>
            </tr>
            <tr class="tab_bg_1">
                <td colspan="2">{{ __('Create a new ticket', 'eventsmanager') }}</td>
                <td colspan="2">
                    {% include '@eventsmanager/event_actions.html.twig' with {event_id: event_id, large: true, actions: ['ticket']} only %}
                </td>
            </tr>
            <tr class="tab_bg_1">
                <td colspan="2">{{ __('Link a existant ticket', 'eventsmanager') }}</td>
                <td colspan="2">{{ ticket_dropdown|raw }}</td>
            </tr>
            <tr class="tab_bg_1 center">
                <td colspan="4">
                    <input type="hidden" name="plugin_eventsmanager_events_id" value="{{ link_event_id }}">
                    <button type="submit" name="ticket_link" class="btn btn-primary">{{ _x('button', 'Save') }}</button>
                </td>
            </tr>
        </table>
    </form>
</div>
